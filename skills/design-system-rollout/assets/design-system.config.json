{
  "stack": "auto",
  "_stack": "auto detects from package.json: tailwind, css or react-native. On React Native also set tokenModule, tokenMap and routesDir (references/react-native.md).",
  "tokenModule": "src/theme/tokens.ts",
  "tokenMap": { "textStyles": "type", "fontSizes": null, "fonts": null, "space": "space", "radius": "radius", "colors": ["palette.day", "palette.night"] },
  "entries": [],
  "assetDirs": ["assets"],
  "srcDirs": ["src", "components"],
  "kitDir": "components/ui",
  "exempt": ["node_modules", "dist", "build"],
  "tokenFiles": ["src/index.css"],
  "typeTokenPrefix": "--ds-text-",
  "typeClassPrefix": "text-ds-",

  "kit": {
    "baseline": "design-system-baseline.json",
    "exempt": ["components/marketing"],
    "disable": [],
    "metrics": {},
    "hints": {}
  },

  "properNames": ["Product Name", "Settings Page Name", "Framework Term"],
  "properWords": ["Brandname"],
  "writing": {
    "otherNames": { "Old Feature Name": "New Feature Name" },
    "exempt": []
  },

  "claudeDesign": {
    "name": "Product Name",
    "themes": { "light": [":root"], "dark": [".dark"] },
    "include": ["--ds-"],
    "ignoreScopes": ["@media (max-width: 767px) :root"],
    "prefixes": {
      "type": "--ds-text-",
      "font": "--ds-font-",
      "radius": "--ds-radius-",
      "spacing": "--ds-space-",
      "shadow": "--ds-shadow-"
    },
    "notes": { "--ds-ink": "Primary text on panel and ground." },
    "textStyles": { "body": { "lineHeight": 1.45, "fontWeight": 500 } },
    "fonts": [
      { "family": "Inter Variable", "src": "node_modules/@fontsource-variable/inter/files/inter-latin-wght-normal.woff2", "as": "Inter-Variable.woff2", "weight": "100 900", "style": "normal" }
    ],
    "contrast": { "text": ["ds-ink", "ds-ink-muted"], "grounds": ["ds-ground", "ds-panel"], "large": [] },
    "overrides": { "tokens": {}, "add": {} },
    "kit": { "namespace": "ProductName", "darkClass": "dark", "previewRoot": "app-shell p-4", "parts": [] },
    "sync": {
      "lock": "claude-design.lock.json",
      "screens": { "Main": ["src/pages/Home.tsx"] }
    }
  },

  "baseUrl": "http://localhost:5173",
  "routes": ["/", "/settings", "/design-system"],
  "audit": {
    "setup": "scripts/audit-setup.mjs",
    "captureRoot": "#root",
    "screens": "scripts/audit-screens.mjs",
    "minTarget": 44,
    "scope": ".app-shell",
    "headerSelector": "header h1"
  }
}
